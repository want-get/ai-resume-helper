# ======================================================================
# 配置模板（单机版 v3）
#
# 说明：**大模型 API Key 不在这里填**。
# 用户在前端界面「模型设置」里填写，保存到数据目录的 settings.json，
# 立即生效、不需要重启程序。本文件只放部署/调优参数。
#
# 复制为 .env 后按需修改；打包成 exe 后不读本文件，直接用内置默认值。
# ======================================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
# 启动后自动打开浏览器
OPEN_BROWSER=true
# 端口被占用时向后顺延尝试的个数
PORT_SCAN_LIMIT=20
DEBUG=false

# ---------- 数据库 ----------
# 单机版默认 SQLite（本地文件），不需要安装任何数据库服务
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# 想用 MySQL 就改成下面这行，并安装 aiomysql
# DATABASE_URL=mysql+aiomysql://root:密码@127.0.0.1:3306/ai_resume_helper?charset=utf8mb4
AUTO_SEED_DB=true
DB_ECHO=false
# 单机版没有并发压力，默认不记录每个请求
PERSIST_REQUEST_LOGS=false

# ---------- 并发（单机版默认值调小）----------
MAX_CONCURRENT_REQUESTS=64
MAX_CONCURRENT_LLM=8
THREAD_POOL_SIZE=16

# ---------- RAG 知识库 ----------
# 递归切分 + 重叠
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_MIN_CHUNK_CHARS=40

# 离线向量化（字符 n-gram 哈希 TF-IDF，不需要下载模型）
RAG_EMBED_DIM=4096
RAG_NGRAM_MIN=2
RAG_NGRAM_MAX=3

# 检索
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_HYBRID=true
RAG_RRF_K=60
AUTO_BUILD_KB=true

# 防幻觉：「检索不到就拒答」的阈值（换语料后建议重新校准）
RAG_MIN_SCORE=0.10
RAG_MIN_MATCHED_IDF=11.0

# ---------- 防幻觉 ----------
ENABLE_CITATION_CHECK=true
REQUIRE_CITATION=true
REFUSE_WITHOUT_CONTEXT=true

# ---------- 长上下文（滑动窗口 + 滚动摘要）----------
MEMORY_WINDOW_MESSAGES=8
MEMORY_WINDOW_MAX_CHARS=4000
MEMORY_SUMMARY_TRIGGER_CHARS=1500
MEMORY_SUMMARY_MAX_CHARS=600
MEMORY_ENABLE_SUMMARY=true

# ---------- 岗位抓取 ----------
# 用 Playwright 驱动系统自带浏览器，不打包 Chromium
CRAWLER_BROWSER_CHANNEL=msedge
CRAWLER_HEADLESS=true
CRAWLER_MAX_PAGES=5
CRAWLER_MAX_JOBS=200
CRAWLER_CONCURRENCY=3
# 只对前 N 条岗位补抓详情页 JD
CRAWLER_DETAIL_LIMIT=15

# ---------- Function Calling ----------
TOOLS_ENABLED=true
MAX_TOOL_ROUNDS=4
TOOL_TIMEOUT=10
JOB_CACHE_TTL=300

# ---------- 运行时设置 ----------
# 允许在前端界面在线修改大模型配置（单机版必须为 true）
ALLOW_RUNTIME_SETTINGS=true

# ---------- 开发用：给大模型配置一个初始默认值 ----------
# 正式使用请在界面「模型设置」里填写，界面上填的优先级更高
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
